# ============================================================
# 環境變數範例檔
# 使用方式：複製這個檔案為 .env，並填入實際的金鑰與設定值
# .env 不應該被提交進版本控制（已經加進 .gitignore）
#
# 注意：要「換模型 / 換 provider」請改 config.yaml，不是這裡——
# 這裡只放機密設定跟跟環境有關的路徑設定。
# ============================================================

# --- OpenAI（可選 provider，非預設；只有 config.yaml 裡某個 provider
#     設成 openai 時才需要填） ---
OPENAI_API_KEY=

# --- ChromaDB 向量資料庫 ---
CHROMA_PERSIST_DIR=./chroma_data

# --- 畫面檔案目錄（FrameLoaderService 依 frame_file 到這裡找圖片） ---
FRAMES_DIR=./frames

# --- 關聯式資料庫 ---
DATABASE_URL=sqlite:///./inference_engine.db

# --- 其他 ---
DEBUG=false

# --- 本地模型快取路徑（選填，但強烈建議設定） ---
# sentence-transformers / huggingface_hub 預設會把模型權重下載到系統磁碟
# （Windows 上通常是 C 槽的使用者資料夾），如果 C 槽空間有限，
# 建議指到其他槽（例如 D:\hf_cache），並確保該資料夾已存在。
# 這幾個變數是第三方套件直接讀 os.environ，不是這個專案自訂的設定，
# 但因為 config/settings.py 會呼叫 load_dotenv()，寫在這裡一樣有效。
# HF_HOME=D:/hf_cache
# TRANSFORMERS_CACHE=D:/hf_cache
# SENTENCE_TRANSFORMERS_HOME=D:/hf_cache
