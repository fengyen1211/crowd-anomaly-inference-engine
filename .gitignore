# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# ============================================================
# 機密設定
# ============================================================
.env

# ============================================================
# 執行期間產生的資料（不應該進版本控制）
# ============================================================
chroma_data/
inference_engine.db
pipeline_output*.json
# 結尾也用萬用字元：做前後對照實驗時報告會帶後綴（例如
# tinyformer7_pipeline_report_cleaned_news.json），原本的
# 「*pipeline_report.json」比對不到，會讓產生出來的報告意外進版控。
# 報告內容該留存時，慣例是摘進進度報告的 .md（那份才進版控）。
tinyformer7*pipeline_report*.json

# 注意：frames/ 故意不整批忽略——裡面除了測試用占位圖，
# 也包含 data/*.json 範例事件實際引用的真實畫面（例如
# tinyformer7_raw_*.jpg），沒有這些檔案 scripts/run_pipeline.py
# 就無法直接跑起來，違背「clone 下來就能測試」的目的。

# ============================================================
# 虛擬環境
# ============================================================
.venv/
venv/

# scripts/fetch_and_index_news.py 自動抓取+摘要產生的新聞批次檔，
# 跟 chroma_data/ 一樣是執行期間產生的資料，不像 knowledge_base_sources/
# 底下的法規文件是手動蒐集、需要版本控制的來源
data/knowledge_base_sources_news/

# ============================================================
# 編輯器
# ============================================================
.vscode/
.idea/

# scripts/nano4/run_model_sweep.sbatch 的對照實驗輸出，結論一樣摘進進度報告的 .md
reports/
